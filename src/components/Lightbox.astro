---
// Click any .lightbox-trigger image to view it larger.
// A native modal <dialog>: the browser handles Esc, the back gesture,
// focus containment, making the page inert, and returning focus on close.
---

<dialog id="lightbox" class="lightbox" aria-label="Photo">
  <button id="lightbox-close" class="absolute top-4 right-4 text-neutral-400 hover:text-neutral-600 transition-colors p-2 z-20" aria-label="Close" autofocus>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="absolute inset-0 flex items-center justify-center p-4 md:p-12">
    <img id="lightbox-img" class="max-h-full max-w-full object-contain" alt="" />
  </div>
</dialog>

<script is:inline>
(function() {
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');

  document.addEventListener('click', function(e) {
    var target = e.target;
    if (target && target.classList && target.classList.contains('lightbox-trigger')) {
      e.preventDefault();
      lightboxImg.src = target.currentSrc || target.src;
      lightboxImg.alt = target.alt || '';
      lightbox.showModal();
    }
  });

  // As before, a click anywhere (backdrop, photo or the close button) closes it.
  lightbox.addEventListener('click', function() {
    lightbox.close();
  });

  lightbox.addEventListener('close', function() {
    lightboxImg.removeAttribute('src');
  });
})();
</script>

<style>
  /* Fill the viewport in white; reset the default dialog box. */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
  }

  /* Keep the page underneath from scrolling, without touching body overflow. */
  .lightbox:modal {
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: #fff;
  }

  .lightbox img {
    transition: opacity 0.15s ease;
  }
</style>
