---
// A small fixed button that flips between light and dark. With nothing stored the
// site follows the system setting; choosing the theme the system already wants
// clears the stored choice, so it goes back to following the system.
---

<button
  id="theme-toggle"
  type="button"
  class="fixed bottom-4 right-4 z-40 p-2 rounded-full text-black press"
  aria-label="Toggle dark mode"
>
  <!-- Sun: shown in dark mode -->
  <!-- Heavier stroke and a larger disc than the other icons: its thin rays otherwise read dimmer. -->
  <svg class="theme-icon-sun w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <!-- Moon: shown in light mode -->
  <svg class="theme-icon-moon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
  </svg>
</button>

<script>
  const KEY = 'theme';
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;

  const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    const system = media.matches ? 'dark' : 'light';
    try {
      if (next === system) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
    } catch {}
    if (next === system) delete root.dataset.theme;
    else root.dataset.theme = next;
  });
</script>
