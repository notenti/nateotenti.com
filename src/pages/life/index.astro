---
import NotedText from '../../components/NotedText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import PostsDrawer from '../../components/PostsDrawer.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const posts = (await getCollection('life', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestPost = posts[0];
const { Content } = latestPost ? await latestPost.render() : { Content: null };
const previousPost = null;
const nextPost = posts.length > 1 ? posts[1] : null;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
  });
};

const formatDateLong = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
};
---

<BaseLayout title="Life - Nate Otenti" description="Photos and thoughts.">
  <main class="min-h-screen p-4 md:p-8">
    <div class="max-w-screen-2xl mx-auto">
      <!-- Mobile header with hamburger -->
      <header class="lg:hidden mb-8 flex items-center justify-between">
        <div>
          <a href="/" class="text-sm font-medium text-neutral-500 hover:text-accent mb-2 inline-block">&larr; home</a>
          <h1 class="text-3xl font-[650] text-neutral-900 tracking-tight">Life</h1>
        </div>
        <button
          id="mobile-menu-toggle"
          class="p-2 text-neutral-600 hover:text-accent transition-colors"
          aria-label="Posts menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </header>

      <PostsDrawer posts={posts} currentSlug={posts[0]?.slug} />

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_16rem] gap-12">
        <!-- Main content area -->
        <div class="min-w-0 max-w-5xl">
          <!-- Desktop header -->
          <header class="hidden lg:block mb-8">
            <a href="/" class="text-sm font-medium text-neutral-500 hover:text-accent mb-2 inline-block">&larr; home</a>
            <h1 class="text-4xl font-[650] text-neutral-900 tracking-tight">Life</h1>
            <p class="text-neutral-500 mt-2">Photos and thoughts.</p>
          </header>

          {posts.length === 0 ? (
            <p class="text-neutral-500">No posts yet. Check back soon!</p>
          ) : (
            <article>
              <header class="mb-8">
                <h2 class="text-2xl md:text-3xl font-semibold text-neutral-900 mb-3">{latestPost.data.title}</h2>
                <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-500">
                  <time class="tabular-nums">{formatDateLong(latestPost.data.date)}</time>
                  <span class="text-neutral-300">·</span>
                  <span>{latestPost.data.location}</span>
                </div>
              </header>

              {latestPost.data.intro && (
                <p class="text-lg text-neutral-600 leading-relaxed mb-10">
                  <NotedText text={latestPost.data.intro} />
                </p>
              )}

              <div class="space-y-2">
                {Content && <Content />}
              </div>

              <div class="mt-16 pt-8 border-t border-neutral-200 flex items-center justify-center gap-2">
                {previousPost && (
                  <>
                    <a href={`/life/${previousPost.slug}`} class="text-sm font-medium text-neutral-500 hover:text-accent transition-colors">
                      &larr; previous
                    </a>
                    <span class="text-neutral-300">·</span>
                  </>
                )}
                <a href="#" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;" class="text-sm font-medium text-neutral-500 hover:text-accent transition-colors">
                  &uarr; back to top
                </a>
                {nextPost && (
                  <>
                    <span class="text-neutral-300">·</span>
                    <a href={`/life/${nextPost.slug}`} class="text-sm font-medium text-neutral-500 hover:text-accent transition-colors">
                      next &rarr;
                    </a>
                  </>
                )}
              </div>
            </article>
          )}
        </div>

        <!-- Desktop sidebar -->
        <aside class="hidden lg:block pt-[7.5rem]">
          <div>
            <span class="text-sm font-medium text-neutral-500 mb-4 block">Posts</span>
            <nav>
              <ul class="space-y-4">
                {posts.map((post, index) => (
                  <li>
                    <a
                      href={`/life/${post.slug}`}
                      class="block transition-colors group"
                    >
                      {post.data.type === 'album' && (
                        <Image
                          src={post.data.cover}
                          alt={post.data.title}
                          width={200}
                          height={150}
                          class="w-3/4 aspect-[4/3] object-cover rounded mb-2 border border-transparent group-hover:border-black transition-colors duration-200 ease-in-out"
                          loading="lazy"
                        />
                      )}
                      <span
                        class:list={[
                          'font-medium',
                          index === 0
                            ? 'text-nvidia underline decoration-nvidia-light underline-offset-4'
                            : 'text-neutral-600 group-hover:text-accent'
                        ]}
                      >
                        {post.data.title}
                      </span>
                      <div class="flex items-center gap-2 mt-0.5">
                        <time class="text-xs text-neutral-400 tabular-nums">{formatDate(post.data.date)}</time>
                        <span class="text-neutral-300">·</span>
                        <span class="text-xs text-neutral-400">{post.data.location}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Lightbox />
</BaseLayout>

<style is:global>
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .animate-shimmer {
    animation: shimmer 1.5s infinite;
  }

  .photo-image {
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }

  .photo-image.loaded {
    opacity: 1 !important;
  }

  .photo-skeleton {
    transition: opacity 0.15s ease-out;
  }

  .photo-container.loaded .photo-skeleton {
    opacity: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Photo loading
    const containers = document.querySelectorAll('.photo-container');
    containers.forEach((container) => {
      const img = container.querySelector('.photo-image') as HTMLImageElement;
      if (img.complete && img.naturalHeight !== 0) {
        container.classList.add('loaded');
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => {
          container.classList.add('loaded');
          img.classList.add('loaded');
        });
        img.addEventListener('error', () => {
          container.classList.add('loaded');
        });
      }
    });
  });
</script>
