---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nate Otenti">
  <main class="min-h-svh flex items-center justify-center px-6 py-16 sm:p-8">
    <div class="max-w-2xl min-w-0 sm:p-8">
      <h1 data-game-text class="text-4xl sm:text-5xl md:text-6xl font-bold text-stone-900 mb-6 tracking-tight">
        Hi, I'm Nate<span id="game-dot" data-game-skip role="button" tabindex="0" aria-label="Play a game" class="game-dot">.</span>
      </h1>
      <p data-game-text class="text-xl sm:text-2xl md:text-3xl text-stone-700 mb-10 font-medium tracking-tight">
        I'm a software engineer working at <a href="https://www.nvidia.com/" class="text-nvidia hover:underline">NVIDIA</a>.
      </p>
      <p data-game-text class="text-lg text-stone-600 leading-relaxed mb-14 max-w-xl">
        When I'm not flipping bits, I'm usually making pizza, playing <span id="disc-golf" role="button" tabindex="0" aria-label="Play disc golf" class="disc-phrase">disc golf</span>,
        practicing yoga, or working in the garden. I live outside of Boston, MA with my wife and our lovely standard poodle.
      </p>

      <div class="w-full sm:w-fit relative">
        <nav id="nav-bar" data-game-text class="flex flex-wrap justify-between gap-x-2 gap-y-3 sm:justify-start sm:gap-8 font-mono text-[13px] sm:text-sm tracking-tight">
          <button
            id="toggle-journey"
            class="text-stone-600 hover:text-nvidia transition-colors cursor-pointer flex items-center gap-1"
          >
            journey
            <svg id="journey-chevron" class="w-2 h-2 text-stone-400 translate-y-0.5 transition-transform duration-300" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 2l4 3-4 3" />
            </svg>
          </button>
          <a href="https://github.com/notenti" target="_blank" rel="noopener noreferrer" class="text-stone-600 hover:text-nvidia inline-flex items-center gap-1">
            github
            <svg class="w-2 h-2 text-stone-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8L8 2M8 2H3.5M8 2v4.5" />
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/nathan-otenti/" target="_blank" rel="noopener noreferrer" class="text-stone-600 hover:text-nvidia inline-flex items-center gap-1">
            linkedin
            <svg class="w-2 h-2 text-stone-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8L8 2M8 2H3.5M8 2v4.5" />
            </svg>
          </a>
          <button
            id="copy-email"
            class="text-stone-600 hover:text-nvidia transition-colors relative cursor-pointer inline-flex items-center gap-1"
            data-email="otenti.nate@gmail.com"
          >
            email
            <svg class="w-2 h-2 text-stone-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="6" height="6" rx="0.5" />
              <path d="M3 7H1.5a.5.5 0 01-.5-.5V1.5a.5.5 0 01.5-.5H6a.5.5 0 01.5.5V3" />
            </svg>
            <span
              id="copy-toast"
              data-game-skip
              class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-xs rounded bg-stone-800 text-white whitespace-nowrap opacity-0 pointer-events-none transition-all duration-300 translate-y-2"
            >
              copied!
            </span>
          </button>
          <a href="/life" class="text-stone-600 hover:text-nvidia">life</a>
        </nav>

        <!-- Journey Timeline -->
        <div
          id="journey-timeline"
          class="absolute left-0 right-0 top-full opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
        >
          <div class="pt-5 pb-1">
            <div class="flex items-center">
              <!-- Aurora -->
              <div class="journey-stop flex items-center gap-1.5 shrink-0 opacity-0 translate-y-1 relative">
                <div class="w-[6px] h-[6px] rounded-full bg-stone-400"></div>
                <div class="journey-label cursor-pointer">
                  <p class="font-mono text-[10px] font-medium text-stone-700 leading-none">Aurora</p>
                  <p class="font-mono text-[8px] text-stone-400 leading-none mt-0.5">2018–2020</p>
                </div>
                <div class="journey-tooltip">
                  <button class="journey-tooltip-close">&times;</button>
                  <p>Software engineer writing flight-critical autonomy software and building out CI/CD infrastructure.</p>
                  <div class="journey-tooltip-arrow"></div>
                </div>
              </div>

              <div class="timeline-seg flex-1 h-px bg-stone-300 mx-2 origin-left scale-x-0"></div>

              <!-- Motional -->
              <div class="journey-stop flex items-center gap-1.5 shrink-0 opacity-0 translate-y-1 relative">
                <div class="w-[6px] h-[6px] rounded-full bg-stone-400"></div>
                <div class="journey-label cursor-pointer">
                  <p class="font-mono text-[10px] font-medium text-stone-700 leading-none">Motional</p>
                  <p class="font-mono text-[8px] text-stone-400 leading-none mt-0.5">2020–2022</p>
                </div>
                <div class="journey-tooltip">
                  <button class="journey-tooltip-close">&times;</button>
                  <p>Senior software engineer building autonomous vehicle evaluation tooling, a dashboard to help visualize AV trajectories, and leading an AWS microservice migration.</p>
                  <div class="journey-tooltip-arrow"></div>
                </div>
              </div>

              <div class="timeline-seg flex-1 h-px bg-stone-300 mx-2 origin-left scale-x-0"></div>

              <!-- Block -->
              <div class="journey-stop flex items-center gap-1.5 shrink-0 opacity-0 translate-y-1 relative">
                <div class="w-[6px] h-[6px] rounded-full bg-stone-400"></div>
                <div class="journey-label cursor-pointer">
                  <p class="font-mono text-[10px] font-medium text-stone-700 leading-none">Block</p>
                  <p class="font-mono text-[8px] text-stone-400 leading-none mt-0.5">2022–2026</p>
                </div>
                <div class="journey-tooltip">
                  <button class="journey-tooltip-close">&times;</button>
                  <p>Senior software engineer focused on hardware developer experience, primarily on software-hardware interaction and tooling for device configuration and testing at scale.</p>
                  <div class="journey-tooltip-arrow"></div>
                </div>
              </div>

              <div class="timeline-seg flex-1 h-px bg-stone-300 mx-2 origin-left scale-x-0"></div>

              <!-- NVIDIA (current) -->
              <div class="journey-stop flex items-center gap-1.5 shrink-0 opacity-0 translate-y-1 relative">
                <div class="relative">
                  <div class="w-[6px] h-[6px] rounded-full bg-nvidia"></div>
                  <div class="absolute inset-0 w-[6px] h-[6px] rounded-full bg-nvidia animate-ping opacity-30"></div>
                </div>
                <div class="journey-label cursor-pointer">
                  <p class="font-mono text-[10px] font-medium text-stone-700 leading-none">NVIDIA</p>
                  <p class="font-mono text-[8px] text-stone-400 leading-none mt-0.5">2026-></p>
                </div>
                <div class="journey-tooltip">
                  <button class="journey-tooltip-close">&times;</button>
                  <p>Just getting started.</p>
                  <div class="journey-tooltip-arrow"></div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

<style>
  .game-dot {
    display: inline-block;
    cursor: pointer;
    outline: none;
    transition: color 150ms ease, transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .game-dot:hover,
  .game-dot:focus-visible {
    color: #76b900;
    transform: translateY(-3px) scale(1.25);
  }

  .disc-phrase {
    display: inline-block;
    cursor: grab;
    touch-action: none;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .disc-phrase:hover,
  .disc-phrase:focus-visible {
    transform: rotate(-3deg);
    outline: none;
  }
  .disc-phrase[data-playing] {
    transform: none;
    transition: none;
  }
  .game-dot[data-playing] {
    color: inherit;
    transform: none;
    transition: none;
  }

  .journey-tooltip {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    padding: 12px 14px;
    border: 1px solid #d6d3d1;
    border-radius: 0.25rem;
    background: white;
    font-size: 11px;
    line-height: 1.5;
    color: #44403c;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease, transform 150ms ease;
    transform: translateX(-50%) translateY(4px);
    z-index: 50;
  }

  .journey-tooltip.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .journey-tooltip-arrow {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background: white;
    border-left: 1px solid #d6d3d1;
    border-top: 1px solid #d6d3d1;
    transform: translateX(-50%) rotate(45deg);
  }

  .journey-tooltip-close {
    position: absolute;
    top: 4px;
    right: 8px;
    background: none;
    border: none;
    font-size: 14px;
    color: #a8a29e;
    cursor: pointer;
    line-height: 1;
    padding: 2px;
  }

  .journey-tooltip-close:hover {
    color: #57534e;
  }

  .journey-label p:first-child {
    transition: color 150ms ease;
  }

  .journey-label:hover p:first-child {
    color: #1c1917;
  }

  .journey-stop > div:first-child {
    transition: transform 150ms ease;
  }

  .journey-stop:hover > div:first-child {
    transform: scale(1.5);
  }

  .journey-tooltip p {
    margin: 0;
    padding-right: 12px;
  }

  /* On phones the timeline spans the full width, so the end tooltips would
     hang off the screen. Pin them to their edge instead of centering. */
  @media (max-width: 639px) {
    .journey-stop:first-of-type .journey-tooltip {
      left: 0;
      transform: translateY(4px);
    }
    .journey-stop:last-of-type .journey-tooltip {
      left: auto;
      right: 0;
      transform: translateY(4px);
    }
    .journey-stop:first-of-type .journey-tooltip.is-visible,
    .journey-stop:last-of-type .journey-tooltip.is-visible {
      transform: translateY(0);
    }
    .journey-stop:first-of-type .journey-tooltip-arrow {
      left: 6px;
    }
    .journey-stop:last-of-type .journey-tooltip-arrow {
      left: auto;
      right: -2px;
    }
  }
</style>

<script>
  const gameDot = document.getElementById('game-dot') as HTMLElement;
  // Only one hidden game runs at a time.
  let playing = false;
  const loadGame = () => import('../scripts/keepy-up');

  async function launchGame() {
    if (playing) return;
    playing = true;
    gameDot.blur();
    const { startKeepyUp } = await loadGame();
    startKeepyUp(gameDot, () => {
      playing = false;
    });
  }

  // Disc golf: drag (or click) the words "disc golf".
  const discPhrase = document.getElementById('disc-golf') as HTMLElement;
  const loadDiscGolf = () => import('../scripts/disc-golf');
  async function launchDiscGolf() {
    if (playing) return;
    playing = true;
    discPhrase.blur();
    const { startDiscGolf } = await loadDiscGolf();
    startDiscGolf(discPhrase, () => {
      playing = false;
    });
  }
  let discDown: { x: number; y: number } | null = null;
  discPhrase.addEventListener('pointerenter', loadDiscGolf, { once: true });
  discPhrase.addEventListener('focus', loadDiscGolf, { once: true });
  discPhrase.addEventListener('pointerdown', (e) => {
    loadDiscGolf();
    discDown = { x: e.clientX, y: e.clientY };
  });
  discPhrase.addEventListener('pointermove', (e) => {
    if (!discDown) return;
    if (Math.hypot(e.clientX - discDown.x, e.clientY - discDown.y) > 6) {
      discDown = null;
      launchDiscGolf();
    }
  });
  window.addEventListener('pointerup', () => (discDown = null));
  discPhrase.addEventListener('click', launchDiscGolf);
  discPhrase.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      launchDiscGolf();
    }
  });

  gameDot.addEventListener('pointerenter', loadGame, { once: true });
  gameDot.addEventListener('focus', loadGame, { once: true });
  gameDot.addEventListener('click', launchGame);
  gameDot.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      launchGame();
    }
  });

  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const toast = document.getElementById('copy-toast') as HTMLSpanElement;

  btn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(btn.dataset.email!);

    toast.style.opacity = '1';
    toast.style.transform = 'translateX(-50%) translateY(0)';

    btn.animate(
      [
        { transform: 'scale(1)' },
        { transform: 'scale(1.2)' },
        { transform: 'scale(1)' },
      ],
      { duration: 300, easing: 'ease-out' }
    );

    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(-50%) translateY(0.5rem)';
    }, 1500);
  });

  const toggleBtn = document.getElementById('toggle-journey') as HTMLButtonElement;
  const timeline = document.getElementById('journey-timeline') as HTMLDivElement;
  const journeyChevron = document.getElementById('journey-chevron') as SVGElement;
  const stops = document.querySelectorAll('.journey-stop');
  const segs = document.querySelectorAll('.timeline-seg');
  let open = false;

  function resetTimeline() {
    stops.forEach((stop) => {
      const el = stop as HTMLElement;
      el.style.transition = 'none';
      el.style.opacity = '0';
      el.style.transform = 'translateY(4px)';
    });
    segs.forEach((seg) => {
      const el = seg as HTMLElement;
      el.style.transition = 'none';
      el.style.transform = 'scaleX(0)';
    });
  }

  const totalDuration = 320;
  const stopDelays = [0, 60, 150, 280];
  const segDelays = [30, 100, 210];

  function playEntrance() {
    resetTimeline();
    void timeline.offsetWidth;

    stops.forEach((stop, i) => {
      const el = stop as HTMLElement;
      setTimeout(() => {
        el.style.transition = 'opacity 120ms cubic-bezier(0.34, 1.56, 0.64, 1), transform 120ms cubic-bezier(0.34, 1.56, 0.64, 1)';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      }, stopDelays[i]);
    });

    segs.forEach((seg, i) => {
      const el = seg as HTMLElement;
      setTimeout(() => {
        el.style.transition = 'transform 100ms cubic-bezier(0.22, 1, 0.36, 1)';
        el.style.transform = 'scaleX(1)';
      }, segDelays[i]);
    });
  }

  function playExit() {
    // Reverse: last items disappear first (fast), earlier items later (slow)
    const stopsArr = Array.from(stops) as HTMLElement[];
    const segsArr = Array.from(segs) as HTMLElement[];
    const lastStop = stopsArr.length - 1;
    const lastSeg = segsArr.length - 1;

    stopsArr.forEach((el, i) => {
      const delay = stopDelays[lastStop - i] * 0.8;
      setTimeout(() => {
        el.style.transition = 'opacity 100ms ease-in, transform 100ms ease-in';
        el.style.opacity = '0';
        el.style.transform = 'translateY(4px)';
      }, delay);
    });

    segsArr.forEach((el, i) => {
      const delay = segDelays[lastSeg - i] * 0.8;
      setTimeout(() => {
        el.style.transition = 'transform 80ms ease-in';
        el.style.transform = 'scaleX(0)';
        el.style.transformOrigin = 'right';
      }, delay);
    });

    setTimeout(() => {
      timeline.style.opacity = '0';
      timeline.style.pointerEvents = 'none';
    }, totalDuration * 0.8 + 100);
  }

  toggleBtn.addEventListener('click', () => {
    open = !open;
    if (open) {
      timeline.style.opacity = '1';
      timeline.style.pointerEvents = 'auto';
      journeyChevron.style.transform = 'translateY(2px) rotate(90deg)';
      // Reset seg origins for entrance
      segs.forEach((seg) => {
        (seg as HTMLElement).style.transformOrigin = 'left';
      });
      requestAnimationFrame(() => playEntrance());
    } else {
      journeyChevron.style.transform = 'translateY(2px) rotate(0deg)';
      // Hide any open tooltips
      document.querySelectorAll('.journey-tooltip.is-visible').forEach((t) => t.classList.remove('is-visible'));
      playExit();
    }
  });

  // Touch has no mouseleave: tapping anywhere outside an open tooltip closes it.
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('.journey-stop')) return;
    document.querySelectorAll('.journey-tooltip.is-visible').forEach((t) => t.classList.remove('is-visible'));
  });

  // Tooltip hover logic
  document.querySelectorAll('.journey-stop').forEach((stop) => {
    const label = stop.querySelector('.journey-label') as HTMLElement;
    const tooltip = stop.querySelector('.journey-tooltip') as HTMLElement;
    const closeBtn = stop.querySelector('.journey-tooltip-close') as HTMLButtonElement;
    let hoverTimeout: ReturnType<typeof setTimeout>;

    label.addEventListener('mouseenter', () => {
      // Hide any other visible tooltips
      document.querySelectorAll('.journey-tooltip.is-visible').forEach((t) => {
        if (t !== tooltip) t.classList.remove('is-visible');
      });
      hoverTimeout = setTimeout(() => {
        tooltip.classList.add('is-visible');
      }, 200);
    });

    label.addEventListener('mouseleave', () => {
      clearTimeout(hoverTimeout);
    });

    tooltip.addEventListener('mouseleave', () => {
      tooltip.classList.remove('is-visible');
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      tooltip.classList.remove('is-visible');
    });
  });
</script>

</BaseLayout>
