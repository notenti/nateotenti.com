---
import BaseLayout from '../layouts/BaseLayout.astro';
import BouncingCircle from '../components/BouncingCircle.astro';
---

<BaseLayout title="Nate Otenti">
  <main class="min-h-svh flex items-center justify-center px-6 py-16 sm:p-8">
    <div class="max-w-2xl min-w-0 sm:p-8">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-[650] text-neutral-900 mb-6 tracking-tight">
        Hi, I'm Nate.
      </h1>
      <p class="text-xl sm:text-2xl md:text-3xl text-neutral-800 mb-10 font-normal tracking-tight">
        I'm a software engineer working at <a href="https://www.nvidia.com/" class="text-neutral-900 underline decoration-neutral-300 decoration-1 underline-offset-4 hover:decoration-neutral-900">NVIDIA</a>.
      </p>
      <p class="text-lg text-neutral-600 leading-relaxed mb-14 max-w-xl">
        When I'm not flipping bits, I'm usually making pizza, playing disc golf,
        practicing yoga, or working in the garden. I live outside of Boston, MA with my wife and our lovely standard poodle.
      </p>

      <div class="w-full sm:w-fit relative">
        <nav id="nav-bar" class="flex flex-wrap justify-between gap-x-2 gap-y-3 sm:justify-start sm:gap-8 text-sm font-medium">
          <a href="https://github.com/notenti" target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-nvidia inline-flex items-center gap-1">
            github
            <svg class="w-2 h-2 text-neutral-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8L8 2M8 2H3.5M8 2v4.5" />
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/nathan-otenti/" target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-nvidia inline-flex items-center gap-1">
            linkedin
            <svg class="w-2 h-2 text-neutral-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8L8 2M8 2H3.5M8 2v4.5" />
            </svg>
          </a>
          <button
            id="copy-email"
            class="text-neutral-600 hover:text-nvidia transition-colors relative cursor-pointer inline-flex items-center gap-1"
            data-email="otenti.nate@gmail.com"
          >
            email
            <svg class="w-2 h-2 text-neutral-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="6" height="6" rx="0.5" />
              <path d="M3 7H1.5a.5.5 0 01-.5-.5V1.5a.5.5 0 01.5-.5H6a.5.5 0 01.5.5V3" />
            </svg>
            <span
              id="copy-toast"
              class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-xs rounded bg-neutral-800 text-white whitespace-nowrap opacity-0 pointer-events-none transition-all duration-300 translate-y-2"
            >
              copied!
            </span>
          </button>
          <a href="/life" class="text-neutral-600 hover:text-nvidia">life</a>
        </nav>
      </div>
    </div>
  </main>

<script>
  // Copy the email address and say so.
  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const toast = document.getElementById('copy-toast') as HTMLSpanElement;
  let toastTimer = 0;
  btn.addEventListener('click', () => {
    navigator.clipboard.writeText(btn.dataset.email!).catch(() => {});
    toast.textContent = 'copied!';
    toast.style.opacity = '1';
    toast.style.transform = 'translateX(-50%) translateY(0)';
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(-50%) translateY(0.5rem)';
    }, 1500);
  });
</script>

  <BouncingCircle />
</BaseLayout>
