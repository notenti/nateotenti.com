---
import BaseLayout from '../layouts/BaseLayout.astro';
import BouncingCircle from '../components/BouncingCircle.astro';
---

<BaseLayout title="Nate Otenti">
  <main class="min-h-svh flex items-center justify-center px-6 py-16 sm:p-8">
    <div class="max-w-2xl min-w-0 sm:p-8">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-[650] text-black mb-6 tracking-tight">
        Hi, I'm Nate.
      </h1>
      <p class="text-xl sm:text-2xl md:text-3xl text-black mb-10 font-normal tracking-tight">
        I'm a software engineer working at <a href="https://www.nvidia.com/" class="text-black ink-link underlined">NVIDIA</a>.
      </p>
      <p class="text-lg text-black leading-relaxed mb-14 max-w-xl">
        When I'm not flipping bits, I'm usually making pizza, playing disc golf,
        practicing yoga, or working in the garden. I live outside of Boston, MA with my wife and our lovely standard poodle.
      </p>

      <div class="w-full sm:w-fit relative">
        <nav id="nav-bar" class="flex flex-wrap justify-between gap-x-2 gap-y-3 sm:justify-start sm:gap-8 text-sm font-medium">
          <a href="https://github.com/notenti" target="_blank" rel="noopener noreferrer" class="text-black inline-flex items-center gap-1 py-2 -my-2">
            <span class="ink-link">github</span>
            <svg class="w-2 h-2 text-neutral-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8L8 2M8 2H3.5M8 2v4.5" />
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/nathan-otenti/" target="_blank" rel="noopener noreferrer" class="text-black inline-flex items-center gap-1 py-2 -my-2">
            <span class="ink-link">linkedin</span>
            <svg class="w-2 h-2 text-neutral-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8L8 2M8 2H3.5M8 2v4.5" />
            </svg>
          </a>
          <button
            id="copy-email"
            class="text-black relative cursor-pointer inline-flex items-center gap-1 py-2 -my-2"
            data-email="otenti.nate@gmail.com"
          >
            <span class="ink-link">email</span>
            <svg class="w-2 h-2 text-neutral-400" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="6" height="6" rx="0.5" />
              <path d="M3 7H1.5a.5.5 0 01-.5-.5V1.5a.5.5 0 01.5-.5H6a.5.5 0 01.5.5V3" />
            </svg>
            <span
              id="copy-toast"
              class="absolute -top-6 left-1/2 -translate-x-1/2 px-2 py-1 text-xs rounded bg-black text-white whitespace-nowrap opacity-0 pointer-events-none transition-all duration-150 translate-y-1"
            >
              copied!
            </span>
          </button>
          <a href="/resume" class="text-black py-2 -my-2"><span class="ink-link">resume</span></a>
          <a href="/life" class="text-black py-2 -my-2"><span class="ink-link">life</span></a>
        </nav>
      </div>
    </div>
  </main>

<script>
  // Copy the email address and say so.
  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const toast = document.getElementById('copy-toast') as HTMLSpanElement;
  let toastTimer = 0;
  const show = (text: string, ms: number) => {
    toast.textContent = text;
    toast.style.opacity = '1';
    toast.style.transform = 'translateX(-50%) translateY(0)';
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(-50%) translateY(0.25rem)';
    }, ms);
  };
  btn.addEventListener('click', () => {
    const email = btn.dataset.email!;
    // If the clipboard is refused (some in-app browsers), show the address instead.
    Promise.resolve()
      .then(() => navigator.clipboard.writeText(email))
      .then(() => show('copied!', 1500), () => show(email, 5000));
  });
</script>

  <BouncingCircle />
</BaseLayout>
