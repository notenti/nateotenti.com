---
import BaseLayout from '../layouts/BaseLayout.astro';

// The one-page resume. This page is the source of truth: after editing it, run
// `npm run resume:pdf` to regenerate public/resume.pdf from it.
---

<BaseLayout
  title="Nate Otenti · Resume"
  description="Senior software engineer who builds the tools other engineers work in: agent platforms, test infrastructure, and the CLIs and APIs around them."
>
  <!-- Sits just left of the theme toggle, in its style. -->
  <a
    id="resume-pdf"
    href="/resume.pdf"
    class="fixed bottom-4 right-12 z-40 p-2 rounded-full text-black press"
    aria-label="Resume as PDF"
    title="Resume as PDF"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9V3h12v6" />
      <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" />
      <path d="M6 14h12v7H6z" />
    </svg>
  </a>

  <article class="resume">

    <header>
      <div>
        <h1>Nate Otenti</h1>
        <p class="thesis">Senior software engineer who builds the tools other engineers work in: agent platforms, test infrastructure, and the CLIs and APIs around them.</p>
      </div>
      <ul class="contact">
        <li><a class="ink-link" href="mailto:otenti.nate@gmail.com">otenti.nate@gmail.com</a></li>
        <li>(508) 320-0804</li>
        <li>Boston, MA</li>
        <li><a class="ink-link" href="https://nateotenti.com">nateotenti.com</a> · <a class="ink-link" href="https://github.com/notenti">github.com/notenti</a></li>
        <li><a class="ink-link" href="https://www.linkedin.com/in/nathan-otenti/">linkedin.com/in/nathan-otenti</a></li>
      </ul>
    </header>

    <section>
      <h2>Experience</h2>
      <div class="entries">

        <div class="job">
          <div class="when"><span>2026 – now</span><span>Remote</span></div>
          <div class="what">
            <div class="head"><span class="org">NVIDIA</span><span class="role">Senior Software Engineer, Datacenter App Engineering</span></div>
            <ul>
              <li>Build and scale an internal AI software factory for Vera Rubin NVL72 development. <b>50+ engineers</b> share its agents, tooling, knowledge base, and system access, and it saves about <b>800 developer hours a month</b>.</li>
              <li>Led the daily evals that score agent-written changelists against human ones on quality, cost, and runtime. The platform now produces valid, researched changelists in about <b>15 minutes</b>.</li>
              <li>Built on-demand developer workspaces on Kubernetes with ZFS snapshots, and MCP integrations that connect agents to Confluence, ticketing, and other internal services.</li>
              <li>Work across the stack in Python and TypeScript: architecture, CI/CD, the Markdown knowledge base, Slack integration, and Prometheus/Grafana observability. Share on-call and pitch the platform to new teams.</li>
            </ul>
          </div>
        </div>

        <div class="job">
          <div class="when"><span>2022 – 2026</span><span>Remote</span></div>
          <div class="what">
            <div class="head"><span class="org">Block</span><span class="role">Senior Software Engineer, Developer Experience</span></div>
            <ul>
              <li>Lead engineer for the software interface to Square’s hardware test platform, which runs <b>thousands of tests a day</b>. Designed one documented API across <b>20+ hardware products</b>.</li>
              <li>Modernized Python tooling across the hardware org, saving about <b>65 machine hours a day</b>.</li>
              <li>Built a Python CLI to configure, debug, and collect metrics from test hardware, so devices can be recovered remotely.</li>
              <li>Designed and maintained an Android Trade Federation platform for large-scale automated mobile testing.</li>
              <li>Led AI adoption in the hardware org, using LLMs and data analysis to automate device recovery, speed up test-failure triage, and shape a data-driven testing strategy.</li>
            </ul>
          </div>
        </div>

        <div class="job">
          <div class="when"><span>2021 – 2022</span><span>Boston · Remote</span></div>
          <div class="what">
            <div class="head"><span class="org">Motional</span><span class="role">Senior Software Engineer, Backend</span></div>
            <ul>
              <li>Led the move of a company-wide dashboard to serverless AWS microservices, cutting maintenance overhead.</li>
              <li>Redesigned the DynamoDB schema, <b>doubling query speed</b> and cutting error rates.</li>
            </ul>
          </div>
        </div>

        <div class="job promo">
          <div class="when"><span>2020 – 2021</span></div>
          <div class="what">
            <div class="head"><span class="role">Software Engineer</span></div>
            <ul>
              <li>Built an autonomous-vehicle evaluation tool in Go that ran <b>20× faster</b> than the legacy tool. Usage grew from 20 to <b>200+ internal users</b>.</li>
            </ul>
          </div>
        </div>

        <div class="job">
          <div class="when"><span>2018 – 2020</span><span>Cambridge, MA</span></div>
          <div class="what">
            <div class="head"><span class="org">Aurora Flight Sciences</span><span class="role">Software Engineer</span></div>
            <ul>
              <li>Developed flight-critical autonomy software in Python and C++11 for emergency landing and route planning.</li>
              <li>Built a GitLab CI/CD pipeline on Docker that made software delivery <b>10× faster</b>.</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <section>
      <h2>Education</h2>
      <div class="entries schools">
        <div class="job">
          <div class="when"><span>2023</span></div>
          <div class="what school"><span class="org">Georgia Institute of Technology</span><span>MS, Computer Science · GPA 4.0</span></div>
        </div>
        <div class="job">
          <div class="when"><span>2018</span></div>
          <div class="what school"><span class="org">Northeastern University</span><span>BS, Computer Engineering · GPA 3.89</span></div>
        </div>
      </div>
    </section>

    <section>
      <h2>Toolkit</h2>
      <dl class="entries pairs">
        <div><dt>Languages</dt><dd>Python, TypeScript, Go, Kotlin, C++</dd></div>
        <div><dt>Infrastructure</dt><dd>Kubernetes, ZFS, PostgreSQL, AWS, Docker, Terraform, GitHub Actions, Prometheus, Grafana</dd></div>
        <div><dt>AI and agents</dt><dd>Agent evals, MCP, LLM knowledge bases</dd></div>
        <div><dt>Off the clock</dt><dd>Gardening, pizza-making, yoga, disc golf, <i>Survivor</i>, poodles</dd></div>
      </dl>
    </section>
  </article>
</BaseLayout>

<style>
  /* One Letter page. A narrow left rail carries when/where; the wide column
     carries the work. Hierarchy from weight, not color or rules. */
  .resume {
    --rail: 1.18in;
    --gap: 0.28in;
    --ink: rgb(var(--ink));
    --muted: rgb(var(--neutral-500));
    --role: rgb(var(--neutral-600)); /* job titles: a step darker than dates and labels */
    --faint: rgb(var(--neutral-400));

    position: relative;
    width: 8.5in;
    max-width: 100%;
    margin: 0 auto;
    padding: 0.48in 0.6in 0.4in;
    color: var(--ink);
    font-size: 8.9pt;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  .resume a { color: inherit; text-decoration: none; }

  header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--gap);
    align-items: end;
    padding-bottom: 0.08in;
  }
  h1 {
    font-size: 25pt;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 0 0 0.12in;
  }
  .thesis {
    margin: 0;
    max-width: 4.6in;
    font-size: 10pt;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    line-height: 1.5;
  }

  section { padding-top: 0.17in; }
  h2 {
    margin: 0 0 0.09in;
    font-size: 10.5pt;
    font-weight: 650;
    letter-spacing: -0.005em;
  }
  .entries { display: grid; gap: 0.11in; min-width: 0; margin: 0; }
  .schools { gap: 0.02in; }

  .job {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    column-gap: var(--gap);
  }
  .job.promo { margin-top: -0.04in; }
  .when { color: var(--muted); }
  .when span { display: block; }
  .what { min-width: 0; }
  .org { font-weight: 600; }
  .head, .school { display: flex; flex-wrap: wrap; column-gap: 0.5em; }
  .head .role { color: var(--role); }

  .what ul {
    margin: 0.04in 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.035in;
  }
  .what li {
    position: relative;
    padding-left: 0.16in;
    text-wrap: pretty;
  }
  .what li::before {
    content: '';
    position: absolute;
    left: 0.02in;
    top: 0.62em;
    width: 0.06in;
    height: 1px;
    background: var(--faint);
  }
  b { font-weight: 580; }

  .pairs { gap: 0.04in; }
  .pairs div { display: grid; grid-template-columns: var(--rail) 1fr; column-gap: var(--gap); }
  .pairs dt { color: var(--muted); }
  .pairs dd { margin: 0; }

  /* Sized in points for the printed page, which reads small on a monitor.
     Scale the whole page up on wide screens; print and the PDF are untouched. */
  @media screen and (min-width: 1000px) {
    .resume { zoom: 1.12; }
  }

  @media (max-width: 700px) {
    .resume { padding: 32px 20px 64px; font-size: 10pt; }
    header { grid-template-columns: 1fr; }
    .contact { text-align: left; }
    .job, .pairs div { grid-template-columns: 1fr; }
    .schools { gap: 0.11in; }
    .when span { display: inline; }
    .when span + span::before { content: ' · '; }
  }

  /* The PDF (npm run resume:pdf) is this page printed: always light, Letter, no chrome. */
  @page { size: letter; margin: 0; }
  @media print {
    :global(html) { color-scheme: light; }
    :global(body) { background: #fff !important; }
    :global(#theme-toggle), #resume-pdf { display: none !important; }
    .resume {
      --ink: #171717;
      --muted: #737373;
      --role: #525252;
      --faint: #a3a3a3;
      width: 8.5in;
      height: 11in;
      overflow: hidden;
      margin: 0;
    }
  }
</style>
