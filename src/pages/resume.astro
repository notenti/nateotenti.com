---
import BaseLayout from '../layouts/BaseLayout.astro';

// The one-page resume. This page is the source of truth: after editing it, run
// `npm run resume:pdf` to regenerate public/resume.pdf from it. The .detail
// blocks are the long version: hidden until the corner toggle opens them, and
// never printed.
const thesis =
  'Senior software engineer who builds developer platforms: the agents, test infrastructure, and APIs that whole engineering orgs work through. Most recently, a founding engineer of NVIDIA’s AI software factory and lead engineer for Square’s hardware test platform.';
---

<BaseLayout
  title="Nate Otenti · Resume"
  description={thesis}
>
  <!-- The corner buttons, in the theme toggle's style: detail, then PDF, then theme. -->
  <button
    id="resume-detail"
    type="button"
    class="fixed bottom-4 right-20 z-40 p-2 rounded-full text-black press"
    aria-pressed="false"
    aria-label="Show the detailed resume"
    title="Show the detailed resume"
  >
    <!-- Unfold: shown while collapsed -->
    <svg class="detail-icon-open w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 15l5 5 5-5M7 9l5-5 5 5" />
    </svg>
    <!-- Fold: shown while expanded -->
    <svg class="detail-icon-close w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 20l5-5 5 5M7 4l5 5 5-5" />
    </svg>
  </button>
  <a
    id="resume-pdf"
    href="/resume.pdf"
    class="fixed bottom-4 right-12 z-40 p-2 rounded-full text-black press"
    aria-label="Resume as PDF"
    title="Resume as PDF"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9V3h12v6" />
      <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" />
      <path d="M6 14h12v7H6z" />
    </svg>
  </a>

  <article class="resume" id="resume">

    <header>
      <div>
        <h1>Nate Otenti</h1>
        <p class="thesis">{thesis}</p>
      </div>
      <ul class="contact">
        <li><a class="ink-link" href="mailto:otenti.nate@gmail.com">otenti.nate@gmail.com</a></li>
        <!-- Phone is for the PDF only, so it isn't scraped off the public page. -->
        <li class="print-only">(508) 320-0804</li>
        <li>Boston, MA</li>
        <li><a class="ink-link" href="https://nateotenti.com">nateotenti.com</a> · <a class="ink-link" href="https://github.com/notenti">github.com/notenti</a></li>
        <li><a class="ink-link" href="https://www.linkedin.com/in/nathan-otenti/">linkedin.com/in/nathan-otenti</a></li>
      </ul>
    </header>

    <section>
      <h2>Experience</h2>
      <div class="entries">

        <div class="job">
          <div class="when"><span>2026 – now</span><span>Remote</span></div>
          <div class="what">
            <div class="head"><span class="org">NVIDIA</span><span class="role">Senior Software Engineer, Datacenter App Engineering</span></div>
            <ul>
              <li>Founding engineer and architect of the AI software factory behind Vera Rubin NVL72 development: the agents, tooling, knowledge base, and system access that <b>50+ engineers</b> share. Other orgs are now adopting it.</li>
              <li>Its agents pick up incoming bug tickets and propose fixes, turning about a day of research and coding into a valid changelist in about <b>15 minutes</b>. That saves an estimated <b>800 developer hours a month</b>.</li>
              <li>Designed and own the evals: real bugs replayed against a depot and tools rolled back to the day each was filed, with the agent’s fix judged against the one a human shipped on quality, cost, and runtime.</li>
              <li>Built on-demand Kubernetes workspaces with ZFS snapshots for the agents, and MCP integrations into Confluence, ticketing, and other internal systems. Share on-call.</li>
            </ul>
            <div class="detail">
              <p><span class="label">How it works</span> Engineers file bugs the way they always have. The agents pick up incoming tickets, research them against a Markdown knowledge base and live access to internal systems, and propose a changelist. Each agent works in its own Kubernetes workspace, cloned from a ZFS snapshot.</p>
              <p><span class="label">Evals</span> The hard question with agents is whether they’re actually any good. We answer it with history. Take a bug a human already fixed, rewind the Perforce depot to the moment it was filed, and date-lock every tool the agent can reach so it can’t see the answer. Then let the agent solve it, and judge its changelist against the human one on quality, cost, and runtime. This runs every day.</p>
              <p><span class="label">What they taught us</span> Context mattered more than the model. The biggest gains came from what the agents could read and reach: the knowledge base and system access. The same daily runs guide our cost and runtime tradeoffs, and catch changes that quietly make the agents worse.</p>
              <p><span class="label">My part</span> Founding engineer. I designed the overall architecture and the eval system, and work across the stack in Python and TypeScript, including CI/CD, Slack integration, and Prometheus/Grafana observability.</p>
              <p><span class="label">Reach</span> Other orgs at NVIDIA are adopting the platform, and leadership points to it as a model for building with AI. The 800 hours is an estimate: tickets the agents handle, times the typical time each takes an engineer by hand.</p>
            </div>
          </div>
        </div>

        <div class="job">
          <div class="when"><span>2022 – 2026</span><span>Remote</span></div>
          <div class="what">
            <div class="head"><span class="org">Block</span><span class="role">Senior Software Engineer, Developer Experience</span></div>
            <ul>
              <li>Lead engineer for the software layer of Square’s hardware test platform, which runs <b>thousands of tests a day</b>. Owned and extended its documented API across <b>20+ hardware products</b>, and set its direction.</li>
              <li>Set the hardware org’s Python tooling standard and led the move to it, saving about <b>65 machine hours a day</b>.</li>
              <li>Built the Python CLI engineers use to configure, debug, and collect metrics from test hardware, so devices can be recovered remotely.</li>
              <li>Designed the Android Trade Federation platform behind large-scale automated mobile testing, and set its roadmap.</li>
            </ul>
            <div class="detail">
              <p><span class="label">The platform</span> More than 20 Square hardware products are tested through it, thousands of times a day. I inherited its API, extended it as more products came on, and kept it one documented interface.</p>
              <p><span class="label">Direction</span> Set the technical direction for three things the hardware org builds on: the test API, its Python tooling standard, and the Android Trade Federation platform.</p>
              <p><span class="label">Tooling</span> The 65 machine hours a day came from faster tooling: modern Python packaging and environments across the org’s test code. The CLI lets engineers configure, debug, and recover test devices without being in the room with them.</p>
              <p><span class="label">AI</span> Championed LLM workflows for test-failure triage and device recovery in the hardware org, through conversations and examples rather than a shipped system.</p>
              <p><span class="label">Stack</span> Python, Kotlin, Android.</p>
            </div>
          </div>
        </div>

        <div class="job">
          <div class="when"><span>2021 – 2022</span><span>Boston · Remote</span></div>
          <div class="what">
            <div class="head"><span class="org">Motional</span><span class="role">Senior Software Engineer, Backend</span></div>
            <ul>
              <li>Led the move of a company-wide dashboard to serverless AWS microservices, and redesigned its DynamoDB schema to <b>double query speed</b>.</li>
            </ul>
          </div>
        </div>

        <div class="job promo">
          <div class="when"><span>2020 – 2021</span></div>
          <div class="what">
            <div class="head"><span class="role">Software Engineer</span></div>
            <ul>
              <li>Built an autonomous-vehicle evaluation tool in Go that ran <b>20× faster</b> than the legacy tool. Usage grew from 20 to <b>200+ internal users</b>.</li>
            </ul>
          </div>
        </div>

        <div class="job">
          <div class="when"><span>2018 – 2020</span><span>Cambridge, MA</span></div>
          <div class="what">
            <div class="head"><span class="org">Aurora Flight Sciences</span><span class="role">Software Engineer</span></div>
            <ul>
              <li>Developed flight-critical autonomy software for emergency landing and route planning in Python and C++11. Built a Docker-based GitLab CI/CD pipeline that made delivery <b>10× faster</b>.</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <section>
      <h2>Education</h2>
      <div class="entries schools">
        <div class="job">
          <div class="when"><span>2023</span></div>
          <div class="what school"><span class="org">Georgia Institute of Technology</span><span>MS, Computer Science · GPA 4.0</span></div>
        </div>
        <div class="job">
          <div class="when"><span>2018</span></div>
          <div class="what school"><span class="org">Northeastern University</span><span>BS, Computer Engineering · GPA 3.89</span></div>
        </div>
      </div>
    </section>

    <section>
      <h2>Toolkit</h2>
      <dl class="entries pairs">
        <div><dt>AI and agents</dt><dd>Agent platforms, evals, MCP integrations, LLM knowledge bases</dd></div>
        <div><dt>Languages</dt><dd>Python, TypeScript, Go, Kotlin, C++</dd></div>
        <div><dt>Infrastructure</dt><dd>Kubernetes, ZFS, PostgreSQL, AWS, Docker, Terraform, GitHub Actions, Prometheus, Grafana</dd></div>
        <div><dt>Off the clock</dt><dd>Gardening, pizza-making, yoga, disc golf, <i>Survivor</i>, poodles</dd></div>
      </dl>
    </section>
  </article>
</BaseLayout>

<script>
  // The detail toggle. #detail in the URL opens it, so the long version can be linked.
  const btn = document.getElementById('resume-detail') as HTMLButtonElement;
  const resume = document.getElementById('resume')!;
  const set = (open: boolean) => {
    resume.classList.toggle('detailed', open);
    btn.setAttribute('aria-pressed', String(open));
    const label = open ? 'Show the short resume' : 'Show the detailed resume';
    btn.setAttribute('aria-label', label);
    btn.title = label;
    history.replaceState(null, '', open ? '#detail' : location.pathname + location.search);
  };
  if (location.hash === '#detail') set(true);
  btn.addEventListener('click', () => set(!resume.classList.contains('detailed')));
</script>

<style>
  /* One Letter page. A narrow left rail carries when/where; the wide column
     carries the work. Hierarchy from weight, not color or rules. */
  .resume {
    /* On screen the type uses the site's sizes; print swaps in the point sizes
       that fit one Letter page. Spacing is in inches, scaled by --k so it keeps
       the same proportions to the type in both. */
    --body: 14px;
    --name: 36px;
    --thesis: 16px;
    --section: 16px;
    --k: 1.18;
    --rail: calc(1.18in * var(--k));
    --gap: calc(0.28in * var(--k));
    --ink: rgb(var(--ink));
    --muted: rgb(var(--neutral-600));
    --faint: rgb(var(--neutral-400));

    position: relative;
    width: calc(8.5in * var(--k));
    max-width: 100%;
    margin: 0 auto;
    padding: calc(0.48in * var(--k)) calc(0.6in * var(--k)) calc(0.4in * var(--k));
    color: var(--ink);
    font-size: var(--body);
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  .resume a { color: inherit; text-decoration: none; }

  header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--gap);
    align-items: end;
    padding-bottom: calc(0.08in * var(--k));
  }
  h1 {
    font-size: var(--name);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
    margin: 0 0 calc(0.12in * var(--k));
  }
  .thesis {
    margin: 0;
    max-width: calc(4.6in * var(--k));
    font-size: var(--thesis);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    line-height: 1.5;
  }

  section { padding-top: calc(0.17in * var(--k)); }
  h2 {
    margin: 0 0 calc(0.09in * var(--k));
    font-size: var(--section);
    font-weight: 600;
  }
  .entries { display: grid; gap: calc(0.11in * var(--k)); min-width: 0; margin: 0; }
  .schools { gap: calc(0.02in * var(--k)); }

  .job {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    column-gap: var(--gap);
  }
  .job.promo { margin-top: calc(-0.04in * var(--k)); }
  .when { color: var(--muted); }
  .when span { display: block; }
  .what { min-width: 0; }
  .org { font-weight: 600; }
  .head, .school { display: flex; flex-wrap: wrap; column-gap: 0.5em; }
  .head .role { color: var(--muted); }

  .what ul {
    margin: calc(0.04in * var(--k)) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: calc(0.035in * var(--k));
  }
  .what li {
    position: relative;
    padding-left: calc(0.16in * var(--k));
    text-wrap: pretty;
  }
  .what li::before {
    content: '';
    position: absolute;
    left: calc(0.02in * var(--k));
    top: 0.62em;
    width: calc(0.06in * var(--k));
    height: 1px;
    background: var(--faint);
  }
  b { font-weight: 600; }

  .pairs { gap: calc(0.04in * var(--k)); }
  .pairs div { display: grid; grid-template-columns: var(--rail) 1fr; column-gap: var(--gap); }
  .pairs dt { color: var(--muted); }
  .pairs dd { margin: 0; }

  /* The detailed view: the long version of each job, opened by the corner toggle. */
  .detail { display: none; margin-top: calc(0.08in * var(--k)); }
  .resume.detailed .detail { display: grid; gap: calc(0.06in * var(--k)); }
  .detail p { margin: 0; text-wrap: pretty; }
  .detail .label { color: var(--muted); margin-right: 0.35em; }
  .print-only { display: none; }
  #resume-detail .detail-icon-close,
  #resume-detail[aria-pressed='true'] .detail-icon-open { display: none; }
  #resume-detail[aria-pressed='true'] .detail-icon-close { display: block; }

  @media (max-width: 700px) {
    .resume { padding: 32px 20px 64px; }
    header { grid-template-columns: 1fr; }
    .contact { text-align: left; }
    .job, .pairs div { grid-template-columns: 1fr; }
    .schools { gap: calc(0.11in * var(--k)); }
    .when span { display: inline; }
    .when span + span::before { content: ' · '; }
  }

  /* The PDF (npm run resume:pdf) is this page printed: always light, Letter, no chrome. */
  @page { size: letter; margin: 0; }
  @media print {
    :global(html) { color-scheme: light; }
    :global(body) { background: #fff !important; }
    :global(#theme-toggle), #resume-pdf, #resume-detail, .detail { display: none !important; }
    .print-only { display: list-item; }
    .resume {
      --body: 8.9pt;
      --name: 25pt;
      --thesis: 10pt;
      --section: 10.5pt;
      --k: 1;
      --ink: #171717;
      --muted: #525252;
      --faint: #a3a3a3;
      width: 8.5in;
      height: 11in;
      overflow: hidden;
      margin: 0;
    }
  }
</style>
